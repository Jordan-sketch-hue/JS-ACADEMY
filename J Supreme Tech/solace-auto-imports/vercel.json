{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/images/logo.png", "destination": "/api/logo-image" },
    { "source": "/favicon.ico", "destination": "/api/logo-image?size=48" },
    { "source": "/backoffice", "destination": "/admin/index.html" },
    { "source": "/backoffice/login", "destination": "/admin/index.html" },
    { "source": "/backoffice/dashboard", "destination": "/admin/index.html" },
    { "source": "/backoffice/vehicles/new", "destination": "/admin/index.html" },
    { "source": "/backoffice/vehicles/:id/edit", "destination": "/admin/index.html" },
    { "source": "/backoffice/vehicles", "destination": "/admin/index.html" },
    { "source": "/backoffice/leads", "destination": "/admin/index.html" },
    { "source": "/backoffice/users", "destination": "/admin/index.html" },
    { "source": "/backoffice/settings", "destination": "/admin/index.html" },
    { "source": "/admin/login", "destination": "/admin/index.html" },
    { "source": "/admin/dashboard", "destination": "/admin/index.html" },
    { "source": "/admin/vehicles/new", "destination": "/admin/index.html" },
    { "source": "/admin/vehicles/:id/edit", "destination": "/admin/index.html" },
    { "source": "/admin/vehicles", "destination": "/admin/index.html" },
    { "source": "/admin/leads", "destination": "/admin/index.html" },
    { "source": "/admin/users", "destination": "/admin/index.html" },
    { "source": "/admin/settings", "destination": "/admin/index.html" },
    { "source": "/vehicle/:id", "destination": "/vehicle.html?id=:id" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|avif|svg|gif|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/admin/(.*)\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()" },
        { "key": "X-DNS-Prefetch-Control", "value": "on" }
      ]
    }
  ]
}
